# Frontend env. Copy to .env.local. The frontend holds NO secrets:
# MONGODB_URI / JWT_SECRET live in the Spring Boot BFF's own .env.

# Where the Spring Boot BFF runs. Read at build time by next.config.mjs.
BFF_URL=http://localhost:8080

# Google OAuth client ID (public, not a secret). Baked in at build time.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- SEO + analytics (all optional, public, baked in at build time) ---
# Public URL of this site: used for canonical links, sitemap and share previews.
NEXT_PUBLIC_SITE_URL=https://utp-codefest-bff-workshop.onrender.com
# Microsoft Clarity project ID (clarity.microsoft.com → Settings → Setup).
NEXT_PUBLIC_CLARITY_ID=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=
# Google Search Console "HTML tag" verification: only the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
