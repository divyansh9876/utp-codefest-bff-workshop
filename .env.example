# Copy to .env.local and fill in real values. Never commit .env.local.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codefest?retryWrites=true&w=majority"
JWT_SECRET="generate-a-long-random-string"
JWT_EXPIRES_IN="1h"

# Google OAuth client ID (public, not a secret). Baked in at build time.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
